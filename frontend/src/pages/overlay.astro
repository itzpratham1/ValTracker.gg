---
import Layout from '../layouts/Layout.astro';
import AppShell from '../components/tracker/AppShell.svelte';

const siteOrigin = Astro.site ? Astro.site.href.replace(/\/$/, '') : Astro.url.origin;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "ValTracker — Live OBS Stream Overlay Studio",
  "applicationCategory": "GameApplication",
  "operatingSystem": "Web",
  "url": `${siteOrigin}/overlay`,
  "description": "Customizable, transparent live Valorant stream overlay for OBS Studio and Twitch streaming with live rank, RR, K/D, ACS, and match telemetry.",
  "featureList": [
    "Real-time Valorant stream overlay for OBS Studio",
    "Customizable themes, colors, and layout presets",
    "Live rank badge, RR progression, and K/D tracking",
    "Transparent browser source integration",
    "Automatic session win/loss and ACS tracking"
  ]
};
---

<Layout
  title="OBS Stream Overlay Studio — Valorant Live Stats Overlay | ValTracker"
  description="Create custom, real-time Valorant stream overlays for OBS Studio and Streamlabs. Display live rank, RR, win rate, K/D, and session stats with transparent styling."
  structuredData={structuredData}
>
  <div class="sr-only" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;">
    <h1>Valorant OBS Stream Overlay Studio & Live Broadcaster HUD</h1>
    <p>Design transparent live stream overlays for Valorant broadcasting on Twitch, YouTube, and Kick. Customize accent colors, metrics, and compact HUD widgets for OBS Studio.</p>
  </div>
  <AppShell client:only="svelte" initialView="overlay" />
</Layout>
